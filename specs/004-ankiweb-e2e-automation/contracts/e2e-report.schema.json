{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "E2EExecutionReportSchema",
  "description": "Schema for structured JSON execution report produced by E2E test suites",
  "type": "object",
  "required": ["suite", "timestamp", "durationMs", "environment", "summary", "cardResults"],
  "properties": {
    "suite": {
      "type": "string",
      "enum": ["AnkiWeb E2E Automation", "Local E2E Component Runner"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "number",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "required": ["nodeVersion", "os", "browser", "mode", "deckName"],
      "properties": {
        "nodeVersion": { "type": "string" },
        "os": { "type": "string" },
        "browser": { "type": "string", "enum": ["chromium"] },
        "mode": { "type": "string", "enum": ["cloud-ankiweb", "local-headless"] },
        "deckName": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["totalCardsTested", "totalAssertions", "passedAssertions", "failedAssertions", "overallStatus"],
      "properties": {
        "totalCardsTested": { "type": "integer", "minimum": 1 },
        "totalAssertions": { "type": "integer", "minimum": 1 },
        "passedAssertions": { "type": "integer", "minimum": 0 },
        "failedAssertions": { "type": "integer", "minimum": 0 },
        "overallStatus": { "type": "string", "enum": ["PASSED", "FAILED"] }
      }
    },
    "typologiesCovered": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "cardResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cardId", "side", "passed", "metrics", "errors"],
        "properties": {
          "cardId": { "type": "string" },
          "viewport": {
            "type": "object",
            "required": ["name", "width", "height"],
            "properties": {
              "name": { "type": "string" },
              "width": { "type": "integer" },
              "height": { "type": "integer" },
              "isMobile": { "type": "boolean" }
            }
          },
          "side": { "type": "string", "enum": ["front", "back"] },
          "passed": { "type": "boolean" },
          "metrics": {
            "type": "object",
            "required": ["scrollWidth", "clientWidth", "hasHorizontalOverflow", "katexErrorCount", "videoMissingAttributes"],
            "properties": {
              "scrollWidth": { "type": "number" },
              "clientWidth": { "type": "number" },
              "hasHorizontalOverflow": { "type": "boolean" },
              "summaryTouchTargetHeight": { "type": "number" },
              "katexErrorCount": { "type": "integer" },
              "videoElementCount": { "type": "integer" },
              "videoMissingAttributes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "highlightJsTokensFound": { "type": "integer" },
              "visualDiffRatio": { "type": "number" }
            }
          },
          "screenshotPath": { "type": "string" },
          "errors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "sanityApkg": { "type": "string" },
        "sessionPath": { "type": "string" },
        "screenshotsDir": { "type": "string" }
      }
    }
  }
}
