{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FlashcardFrontmatterContract",
  "type": "object",
  "required": ["id", "title", "tags"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "pattern": "^(level::(l3-junior|l4-pleno|l5-senior)|topic::[a-z0-9_-]+::[a-z0-9_-]+|company::[a-z0-9_-]+|freq::(high|medium|low))$"
      }
    }
  },
  "additionalProperties": false
}
