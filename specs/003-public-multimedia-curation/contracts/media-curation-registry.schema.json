{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaCurationRegistry",
  "description": "Schema for the canonical multimedia curation catalog for the FAANG Anki Deck",
  "type": "object",
  "required": ["version", "last_updated", "stats", "cards"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "stats": {
      "type": "object",
      "required": ["total_cards", "p1_video_count", "p2_svg_count", "p2_table_count"],
      "properties": {
        "total_cards": { "type": "integer", "minimum": 0 },
        "p1_video_count": { "type": "integer", "minimum": 0 },
        "p2_svg_count": { "type": "integer", "minimum": 0 },
        "p2_table_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "cards": {
      "type": "object",
      "patternProperties": {
        "^[A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$": {
          "$ref": "#/definitions/MediaCurationEntry"
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "MediaCurationEntry": {
      "type": "object",
      "required": ["card_id", "subtopic_id", "concept", "tier", "media_type", "attribution", "license", "caption", "status"],
      "properties": {
        "card_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$"
        },
        "subtopic_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "concept": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "tier": {
          "type": "string",
          "enum": ["P1_MICRO_VIDEO", "P2_RESPONSIVE_SVG", "P2_TABLE_FALLBACK", "LOCAL_ASSET"]
        },
        "url": {
          "type": "string",
          "pattern": "^https://[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}(/.*)?$"
        },
        "media_type": {
          "type": "string",
          "enum": [
            "video/mp4",
            "video/webm",
            "image/svg+xml",
            "image/webp",
            "image/gif",
            "image/png",
            "inline_svg",
            "markdown_table",
            "mp4",
            "webm",
            "gif"
          ]
        },
        "attribution": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "license": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "caption": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["verified", "pending", "pending_injection", "deprecated"]
        },
        "last_verified": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
