{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LinkHealthReport",
  "description": "Schema for the link-health-report.json generated by link-checker.js",
  "type": "object",
  "required": ["timestamp", "total_audited", "passed_count", "failed_count", "duration_ms", "results"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "total_audited": {
      "type": "integer",
      "minimum": 0
    },
    "passed_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["card_id", "file_path", "url", "http_status", "passed", "latency_ms"],
        "properties": {
          "card_id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[A-Z0-9]+-[A-Z0-9]+-[0-9]{3}$"
          },
          "file_path": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "http_status": {
            "type": "integer"
          },
          "content_type": {
            "type": "string"
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "passed": {
            "type": "boolean"
          },
          "error_message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
